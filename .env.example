# Copy this file to .env.local. .env.local is git-ignored and never committed.
#
# LOCAL DEVELOPMENT uses the local Supabase instance only (`just up` starts it).
# The app refuses to connect to any non-local host unless it is running on Vercel
# (see lib/db/target.ts). The hosted Supabase connection string lives ONLY in
# Vercel → Settings → Environment Variables, never in a file on this machine.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres

# Better Auth — signs and encrypts the session cookie.
# Generate your own with:  openssl rand -base64 32
# Vercel needs its own, DIFFERENT value in Settings -> Environment Variables.
# Without it the build still goes GREEN but nobody can sign in, so set it first.
BETTER_AUTH_SECRET=replace-me-with-a-random-32-byte-string

# Local only. Do NOT set this on Vercel: left unset, Better Auth takes the origin
# from the request, so production and every preview deployment both work. Pinning
# it to one domain breaks sign-in on preview URLs.
BETTER_AUTH_URL=http://localhost:3000
